# Copy this file to .env and fill in what you have.
# Anything left blank will make the related feature show a "Connect API" state
# in the UI instead of fake data.

JWT_SECRET=change_this_to_a_long_random_string

# Groq (used for AI Rescue Planner + AI Farm Assistant chat)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap (used for Weather Intelligence)
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

